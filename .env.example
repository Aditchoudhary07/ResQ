# ResQ — required configuration (example only, no real values)
#
# ResQ is a static website, so the browser reads these values from config.js,
# not from a .env file. Copy config.example.js to config.js and fill in:
#
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_publishable_key
#
# Never put these in config.js, .env or anywhere in the repository:
#   - Supabase secret / service-role key
#   - Database password
