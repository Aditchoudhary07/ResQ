# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# ResQ — local Supabase connection (copy config.example.js → config.js)
config.js

# ResQ — never commit secrets
*.key
*secret*
*service-role*

# Unused Next.js starter scaffold (kept locally, not part of the ResQ site)
/src/
/public/
package.json
package-lock.json
tsconfig.json
next.config.ts
eslint.config.mjs
AGENTS.md
README.nextjs.md

# Local screenshots
*.png

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
